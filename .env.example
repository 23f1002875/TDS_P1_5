# Your Telegram Bot Token from BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI or compatible LLM API Key (e.g., AnyScale, Together, OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM Model to use
LLM_MODEL=gpt-4o

# The public URL where this app is hosted (used for Telegram Webhook and Log URLs)
# Render automatically provides RENDER_EXTERNAL_URL
HOST_URL=https://your-app-name.onrender.com
